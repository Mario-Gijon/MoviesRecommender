COMPOSE_PROJECT_NAME=movies-recommender-local
DATA_DIR=./data
BACKEND_PORT=18014
FRONTEND_PORT=15173
BACKEND_BIND_HOST=127.0.0.1
FRONTEND_BIND_HOST=127.0.0.1

# Root Compose environment; copy this file to .env. Do not commit a TMDB token.
# Requests select algorithms; these values choose deploy-time model variants.
MOVIES_RECOMMENDER_TMDB_BEARER_TOKEN=
MOVIES_RECOMMENDER_ACTIVE_COLLABORATIVE_MODEL_VARIANT=top_k_100_min_support_25
MOVIES_RECOMMENDER_BIASED_MATRIX_FACTORIZATION_MODEL_VARIANT=factors_128_epochs_100_lr_0_005_reg_0_02
